			"x": -1120,
			"y": -140,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_12",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/12_One_Tap_and_Passive_Recording.md",
			"x": -840,
			"y": -140,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_13",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/13_Whisper_ASR_Speech_To_Text.md",
			"x": -560,
			"y": -140,
			"width": 260,
			"height": 180,
			"color": "5"
		},
		{
			"id": "feat_14",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/14_Conversational_Chat_With_Set_Tape.md",
			"x": -840,
			"y": 100,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_14_note",
			"type": "text",
			"text": "**Talk to your notes:**\n\nFind context, find your notes and compare past versions of a joke with a current one.",
			"x": -1120,
			"y": 100,
			"width": 260,
			"height": 180,
			"color": "4"
		},
		{
			"id": "ghost_mode",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/01_Ghost_Mode_Distraction_Shield.md",
			"x": -180,
			"y": -430,
			"width": 360,
			"height": 150,
			"color": "1"
		},
		{
			"id": "ghost_note",
			"type": "text",
			"text": "**Ghost Mode:**\n\nLimit distractions while you write. The app puts the device in airplane / DND mode with offline local storage.",
			"x": 200,
			"y": -430,
			"width": 260,
			"height": 150,
			"color": "1"
		},
		{
			"id": "text_boundary",
			"type": "group",
			"label": "text forward (Keep Simplicity)",
			"x": 500,
			"y": -460,
			"width": 960,
			"height": 820,
			"color": "3"
		},
		{
			"id": "text_header",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/20_Text_Forward_Capture_Layer.md",
			"x": 540,
			"y": -430,
			"width": 380,
			"height": 160,
			"color": "3"
		},
		{
			"id": "text_desc",
			"type": "text",
			"text": "**The Instant Capture Layer (Keep Simplicity):**\n\nTapping the mobile widget opens an immediate blank line (no title, no folder selection, no tag prompt).\n\nType 2 words (e.g., 'Zoo lions') or speak a 5-second voice memo. It saves instantly.",
			"x": 940,
			"y": -430,
			"width": 480,
			"height": 180,
			"color": "3"
		},
		{
			"id": "feat_21",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/21_Distraction_Free_Markdown_Pad.md",
			"x": 540,
			"y": -140,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_22",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/22_Zero_Click_Floating_Capture_Widget.md",
			"x": 820,
			"y": -140,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_23",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/23_Inline_Delivery_Notation_Engine.md",
			"x": 1100,
			"y": -140,
			"width": 260,
			"height": 180
		},
		{
			"id": "feat_23_note",
			"type": "text",
			"text": "**Notation:**\n\nAdd notation to your notes to quickly capture and communicate how to read / perform a joke on stage (`💥`, `🥊`, `💤`, `🗣️`, `🤸`).",
			"x": 1100,
			"y": 60,
			"width": 260,
			"height": 180
		},
		{
			"id": "comparator_header",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/30_The_Comparator_Bridge.md",
			"x": -210,
			"y": -160,
			"width": 420,
			"height": 170,
			"color": "2"
		},
		{
			"id": "comparator_note",
			"type": "text",
			"text": "**The Comparator Bridge (The Secret Sauce):**\n\nThe system automatically aligns spoken stage audio against your written notes.\n- **Green words** = Ad-libs on stage\n- **Red strikethrough** = Written lines you forgot\n- **Waveform spikes** = Exact laugh duration",
			"x": 230,
			"y": -160,
			"width": 440,
			"height": 170,
			"color": "2"
		},
		{
			"id": "feat_31",
