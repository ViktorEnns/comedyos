		},
		{
			"id": "audio_header",
			"type": "file",
			"file": "Comedy_OS_Note_Taker_Vault/10_Audio_Forward_Ingestion_Layer.md",
			"x": -760,
			"y": -430,
			"width": 380,
			"height": 160,
			"color": "4"
		},
		{
			"id": "audio_desc",
			"type": "text",
			"text": "**The Performance Ingestion Layer (Granola Intelligence):**\n\nBefore stepping on stage, hit Record (or set it to auto-record based on venue GPS and time).\n\nThe app records the room, separates comic speech from audience reaction, and transcribes the set.",
			"x": -1120,
			"y": -430,
			"width": 340,
			"height": 260,
			"color": "4"
		},
		{
			"id": "feat_11",
